{
  "version": 1,
  "groups": [
    {
      "id": "notifications",
      "label": "Notifications affichées dans ALICE",
      "description": "Règle la durée, l’animation et les couleurs des bandeaux d’information visibles en haut de l’application.",
      "options": [
        { "id": "notifications.displayDurationMs", "label": "Temps d’affichage", "type": "number", "unit": "ms", "value": 7000, "default": 7000, "min": 1000, "max": 60000, "step": 500 },
        { "id": "notifications.transitionDurationMs", "label": "Durée de disparition", "type": "number", "unit": "ms", "value": 220, "default": 220, "min": 0, "max": 3000, "step": 10 },
        { "id": "colors.notification.info", "label": "Couleur des informations", "type": "color", "value": "#1d4ed8", "default": "#1d4ed8" },
        { "id": "colors.notification.warning", "label": "Couleur des avertissements", "type": "color", "value": "#b45309", "default": "#b45309" },
        { "id": "colors.notification.critical", "label": "Couleur des alertes critiques", "type": "color", "value": "#b91c1c", "default": "#b91c1c" }
      ]
    },
    {
      "id": "map",
      "label": "Carte principale : démarrage et niveaux de zoom",
      "description": "Détermine la zone affichée à l’ouverture et le moment où les informations ferroviaires apparaissent sur la carte.",
      "options": [
        { "id": "map.initialLongitude", "label": "Longitude de départ", "type": "number", "unit": "°", "value": 2.35, "default": 2.35, "min": -180, "max": 180, "step": 0.01 },
        { "id": "map.initialLatitude", "label": "Latitude de départ", "type": "number", "unit": "°", "value": 48.85, "default": 48.85, "min": -85, "max": 85, "step": 0.01 },
        { "id": "map.initialZoom", "label": "Zoom initial", "type": "number", "unit": "niveau", "value": 6, "default": 6, "min": 2, "max": 19, "step": 0.1 },
        { "id": "map.maximumZoom", "label": "Zoom maximal", "type": "number", "unit": "niveau", "value": 19, "default": 19, "min": 10, "max": 24, "step": 0.1 },
        { "id": "map.startFitMaximumZoom", "label": "Zoom maximal du cadrage de départ", "type": "number", "unit": "niveau", "value": 10.8, "default": 10.8, "min": 2, "max": 19, "step": 0.1 },
        { "id": "map.pkMinimumZoom", "label": "Zoom d’apparition des PK", "type": "number", "unit": "niveau", "value": 11, "default": 11, "min": 2, "max": 19, "step": 0.1 },
        { "id": "map.pkSearchZoom", "label": "Zoom lors d’une recherche PK", "type": "number", "unit": "niveau", "value": 17.15, "default": 17.15, "min": 2, "max": 19, "step": 0.05 },
        { "id": "map.trackLabelsMinimumZoom", "label": "Zoom d’apparition des numéros de voie", "type": "number", "unit": "niveau", "value": 15.5, "default": 15.5, "min": 2, "max": 19, "step": 0.1 },
        { "id": "map.ignSatelliteSwitchZoom", "label": "Passage automatique au satellite IGN", "type": "number", "unit": "niveau", "value": 13, "default": 13, "min": 2, "max": 19, "step": 0.1 },
        { "id": "map.ignSatelliteFadeEndZoom", "label": "Fin du fondu satellite IGN", "type": "number", "unit": "niveau", "value": 16, "default": 16, "min": 2, "max": 19, "step": 0.1 },
        { "id": "map.ignSatelliteMaximumOpacity", "label": "Opacité maximale du satellite IGN", "type": "number", "unit": "%", "value": 100, "default": 100, "min": 0, "max": 100, "step": 5 }
      ]
    },
    {
      "id": "display",
      "label": "Carte principale : tailles et dimensions",
      "description": "Règle la taille des éléments manipulés sur la carte et le nombre de fiches pouvant rester ouvertes.",
      "options": [
        { "id": "display.measureSelectionRadiusPx", "label": "Rayon de sélection des points de mesure", "type": "number", "unit": "px", "value": 18, "default": 18, "min": 4, "max": 60, "step": 1 },
        { "id": "display.measureLabelSpacingPx", "label": "Espacement des graduations de mesure", "type": "number", "unit": "px", "value": 90, "default": 90, "min": 20, "max": 300, "step": 5 },
        { "id": "display.apparatusGroupIconDiameterPx", "label": "Diamètre des groupes d’appareils", "type": "number", "unit": "px", "value": 84, "default": 84, "min": 24, "max": 180, "step": 2 },
        { "id": "display.maximumOpenSheets", "label": "Nombre maximal de fiches ouvertes", "type": "number", "unit": "fiches", "value": 2, "default": 2, "min": 1, "max": 10, "step": 1 }
      ]
    },
    {
      "id": "interaction",
      "label": "Utilisation de la carte : gestes et délais",
      "description": "Règle les appuis longs, les délais de chargement, le suivi GPS et la durée des mises en évidence.",
      "options": [
        { "id": "interaction.longPressDurationMs", "label": "Durée de l’appui long", "type": "number", "unit": "ms", "value": 800, "default": 800, "min": 250, "max": 3000, "step": 50 },
        { "id": "interaction.dataStartupDelayMs", "label": "Délai de chargement initial des données", "type": "number", "unit": "ms", "value": 220, "default": 220, "min": 0, "max": 5000, "step": 10 },
        { "id": "interaction.locationFollowPauseMs", "label": "Suspension du suivi après déplacement", "type": "number", "unit": "ms", "value": 5000, "default": 5000, "min": 0, "max": 60000, "step": 500 },
        { "id": "interaction.pnSearchHighlightMs", "label": "Temps de mise en évidence d’un PN recherché", "type": "number", "unit": "ms", "value": 20000, "default": 20000, "min": 1000, "max": 120000, "step": 1000 },
        { "id": "interaction.pendingApparatusHours", "label": "Conservation d’un appareil en attente", "type": "number", "unit": "h", "value": 24, "default": 24, "min": 1, "max": 720, "step": 1 },
        { "id": "interaction.minimumPkGapMeters", "label": "Écart signalé entre deux plages PK", "type": "number", "unit": "m", "value": 1000, "default": 1000, "min": 10, "max": 10000, "step": 10 }
      ]
    },
